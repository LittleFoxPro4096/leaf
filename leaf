#!/usr/bin/env bash

RED_COLOR="\e[1;31m"
YELLOW_COLOR="\e[1;33m"
PURPLE_COLOR="\e[1;35m"
GREEN_COLOR="\e[1;32m"
CLEAR_COLOR="\e[0m"

source /etc/leaf.conf

export LC_ALL=C
if ! [[ "${PARALLEL_JOBS}" =~ ^[0-9]+$ ]]; then
  PARALLEL_JOBS="4"
fi
export MAKEFLAGS="-j${PARALLEL_JOBS}"
export NINJAJOBS="${PARALLEL_JOBS}"
LEAF_DIR="${LEAF_DIR:-/var/lib/leaf}"
DIST_DIR="${DIST_DIR:-${LEAF_DIR}/distfiles}"
BUILD_DIR="${BUILD_DIR:-${LEAF_DIR}/build}"
PKGBUILD_DIR="${PKGBUILD_DIR:-${LEAF_DIR}/pkgbuild}"
TRACE_DIR="${TRACE_DIR:-${LEAF_DIR}/trace}"
HOOK_DIR="${HOOK_DIR:-${LEAF_DIR}/hooks}"
BINARY_DIR="${BINARY_DIR:-${LEAF_DIR}/binaries}"
TEMP_DIR="${TEMP_DIR:-${LEAF_DIR}/temp}"
INSTALLED_PACKAGES="${INSTALLED_PACKAGES:-${LEAF_DIR}/installed}"
LOG_DIR="${LOG_DIR:-${LEAF_DIR}/logs}"
LOG_KEEP="${LOG_KEEP:-20}"
VERBOSE="${VERBOSE:-false}"
DEFAULT_BUILD_OPTIONS=("strip" "!libtool" "zipman")
COMPRESS_PROG="${COMPRESS_PROG:-zstd -19 -T0}"
BINARY_EXT="${BINARY_EXT:-.pkg.tar.zst}"
ENABLE_DEBUG_TREE="${ENABLE_DEBUG_TREE:-true}"

declare -A BUILD_OPTIONS=([strip]="0" [libtool]="0" [zipman]="0")

MESSAGE_FILE=""
BUILD_LOG_FILE=""
TRANS_LOG_FILE=""
CURRENT_LOG=""
LEAF_COMMAND=""
LEAF_PHASE=""

main() {
  trap 'rm -f "${MESSAGE_FILE}"' EXIT
  trap leaf_on_sigint INT
  MESSAGE_FILE="$(mktemp)" || leaf_error "Failed to create temporary file"
  leaf_create_directories

  local _args=() _a
  for _a in "$@"; do
    case "${_a}" in
      -v|--verbose)
        VERBOSE="true"
        ;;
      *)
        _args+=("${_a}")
        ;;
    esac
  done
  set -- "${_args[@]}"
  LEAF_COMMAND="${1:-}"

  local _summary=() _failed="false"
  local _i _total _item _start _elapsed _log _rc

  case "${1:-}" in
    clean)
      leaf_check_permission
      rm -rf "${BUILD_DIR}"/* "${TEMP_DIR}"/*
      if [[ "${2:-}" == "--logs" ]]; then
        rm -rf "${LOG_DIR}"/build/* "${LOG_DIR}"/transaction/*
        : > "${LOG_DIR}"/leaf.log
        leaf_journal INFO "cleaned build/temp directories and all logs"
        leaf_info "The build/temp directories and logs have been cleaned"
      else
        leaf_journal INFO "cleaned build/temp directories"
        leaf_info "The build/temp directories have been cleaned"
      fi
      ;;
    list)
      cat "${INSTALLED_PACKAGES}"
      ;;
    search)
      leaf_search_package "${@:2}"
      ;;
    show)
      for _item in "${@:2}"; do
        leaf_find_pkgbuild "${_item}"
        leaf_show_package
      done
      ;;
    prepare|build|install|remove|pack)
      leaf_check_permission
      local _ok
      case $1 in
        prepare) _ok="PREPARED" ;;
        build)   _ok="BUILT" ;;
        install) _ok="INSTALLED" ;;
        remove)  _ok="REMOVED" ;;
        pack)    _ok="PACKED" ;;
      esac
      leaf_journal INFO "Command: leaf $* (user=$(whoami))"
      _total=$(($# - 1)) && _i=0
      for _item in "${@:2}"; do
        _i=$((_i + 1))
        leaf_find_pkgbuild "${_item}"
        leaf_reset_state
        source "${PKGBUILD_DIR}/${PKG_PREFIX}/${PKG_NAME}".PKGBUILD || leaf_error "Failed to load ${PKG_PREFIX}/${PKG_NAME}.PKGBUILD"
        leaf_parse_options
        srcdir="${BUILD_DIR}/${PKG_PREFIX}/${PKG_NAME}"
        pkgdir="${srcdir}"/__pkgdir__
        leaf_setup_logs
        leaf_banner "${_i}" "${_total}" "${PKG_PREFIX}/${PKG_NAME}"
        if [[ "${_failed}" == "true" ]]; then
          echo -e "  ${YELLOW_COLOR}-> SKIPPED (previous package failed)${CLEAR_COLOR}"
          leaf_journal WARNING "$1 ${PKG_PREFIX}/${PKG_NAME} SKIPPED (previous package failed)"
          _summary+=("$(printf '%-12s %s' "SKIPPED" "${PKG_PREFIX}/${PKG_NAME}")")
          continue
        fi
        rm -rf "${srcdir}" && install -dm755 "${srcdir}" && cd "${srcdir}" || leaf_error "Failed to enter ${srcdir}"
        _start=${SECONDS}
        leaf_${1}_package
        _rc=$?
        if [ ${_rc} -eq 0 ]; then
          _elapsed=$((SECONDS - _start))
          _summary+=("$(printf '%-12s %s  (%ss)' "${_ok}" "${PKG_PREFIX}/${PKG_NAME}" "${_elapsed}")")
          leaf_journal INFO "$1 ${PKG_PREFIX}/${PKG_NAME} OK (elapsed=${_elapsed}s)"
          leaf_trim_logs "${PKG_PREFIX}"
        else
          _failed="true"
          _elapsed=$((SECONDS - _start))
          _summary+=("$(printf '%-12s %s  (%ss)  log: %s' "FAILED" "${PKG_PREFIX}/${PKG_NAME}" "${_elapsed}" "${CURRENT_LOG}")")
          leaf_journal ERROR "$1 ${PKG_PREFIX}/${PKG_NAME} FAILED (elapsed=${_elapsed}s, log=${CURRENT_LOG})"
          leaf_trim_logs "${PKG_PREFIX}"
        fi
      done
      ;;
    unpack)
      leaf_check_permission
      leaf_journal INFO "Command: leaf $* (user=$(whoami))"
      _total=$(($# - 1)) && _i=0
      for _item in "${@:2}"; do
        _i=$((_i + 1))
        leaf_reset_state
        leaf_banner "${_i}" "${_total}" "$(basename "${_item}")"
        if [[ "${_failed}" == "true" ]]; then
          echo -e "  ${YELLOW_COLOR}-> SKIPPED (previous package failed)${CLEAR_COLOR}"
          leaf_journal WARNING "unpack $(basename "${_item}") SKIPPED (previous package failed)"
          _summary+=("$(printf '%-12s %s' "SKIPPED" "$(basename "${_item}")")")
          continue
        fi
        srcdir="${TEMP_DIR}/$(basename ${_item%.pkg.*})"
        pkgdir="${srcdir}"/__pkgdir__
        rm -rf "${srcdir}" && install -dm755 "${srcdir}" && cd "${srcdir}" || leaf_error "Failed to enter ${srcdir}"
        _start=${SECONDS}
        leaf_unpack_package "${_item}"
        _rc=$?
        if [ ${_rc} -eq 0 ]; then
          _elapsed=$((SECONDS - _start))
          _summary+=("$(printf '%-12s %s  (%ss)' "INSTALLED" "${PKG_PREFIX}/${PKG_NAME}" "${_elapsed}")")
          leaf_journal INFO "unpack ${PKG_PREFIX}/${PKG_NAME} OK (elapsed=${_elapsed}s)"
          leaf_trim_logs "${PKG_PREFIX}"
        else
          _failed="true"
          _elapsed=$((SECONDS - _start))
          _summary+=("$(printf '%-12s %s  (%ss)  log: %s' "FAILED" "$(basename "${_item}")" "${_elapsed}" "${CURRENT_LOG}")")
          leaf_journal ERROR "unpack $(basename "${_item}") FAILED (elapsed=${_elapsed}s, log=${CURRENT_LOG})"
          leaf_trim_logs "${PKG_PREFIX}"
        fi
      done
      ;;
    *)
      leaf_print_usage
      ;;
  esac

  if [ ${#_summary[@]} -gt 1 ]; then
    printf '\n'
    echo -e "${PURPLE_COLOR}==================== Summary ====================${CLEAR_COLOR}"
    for _item in "${_summary[@]}"; do
      case "${_item}" in
        FAILED*)  echo -e "${RED_COLOR}${_item}${CLEAR_COLOR}" ;;
        SKIPPED*) echo -e "${YELLOW_COLOR}${_item}${CLEAR_COLOR}" ;;
        *)        echo -e "${GREEN_COLOR}${_item}${CLEAR_COLOR}" ;;
      esac
    done
  fi
  if [ -s "${MESSAGE_FILE}" ]; then
    cat "${MESSAGE_FILE}"
  fi
  [[ "${_failed}" == "false" ]]
}

leaf_banner() {
  if [ "$2" -gt 1 ]; then
    echo -e "${PURPLE_COLOR}==> [${1}/${2}] ${3}${CLEAR_COLOR}"
  else
    echo -e "${PURPLE_COLOR}==> ${3}${CLEAR_COLOR}"
  fi
}

leaf_setup_logs() {
  local _ts="$(date '+%Y%m%d-%H%M%S')"
  BUILD_LOG_FILE="${LOG_DIR}/build/${PKG_PREFIX}/${PKG_NAME}-${_ts}.log"
  TRANS_LOG_FILE="${LOG_DIR}/transaction/${PKG_PREFIX}/${PKG_NAME}-${_ts}.log"
  install -dm755 "${LOG_DIR}/build/${PKG_PREFIX}" "${LOG_DIR}/transaction/${PKG_PREFIX}"
  CURRENT_LOG=""
}

leaf_trim_logs() {
  local _category _count _file
  for _category in build transaction; do
    [ -d "${LOG_DIR}/${_category}/$1" ] || continue
    ls -1t "${LOG_DIR}/${_category}/$1" 2>/dev/null | tail -n "+$((LOG_KEEP + 1))" | while read -r _file; do
      rm -f "${LOG_DIR}/${_category}/$1/${_file}"
    done
  done
}

leaf_journal() {
  local _level="$1"
  shift
  printf '[%s] [%s] %s\n' "$(date '+%FT%T%:z')" "${_level}" "$*" >> "${LOG_DIR}/leaf.log"
}

# print the colored message to the terminal and a plain-text copy to the current log file
leaf_emit() {
  if { echo -e "$1" > /dev/tty; } 2>/dev/null; then
    [ -z "${CURRENT_LOG}" ] || echo "$2" >> "${CURRENT_LOG}"
  else
    echo "$2"
  fi
}

leaf_error() {
  leaf_emit "${RED_COLOR}ERROR: $1${CLEAR_COLOR}" "ERROR: $1"
  exit 1
}

leaf_warning() {
  leaf_emit "${YELLOW_COLOR}WARNING: $1${CLEAR_COLOR}" "WARNING: $1"
}

leaf_info() {
  leaf_emit "${GREEN_COLOR}* $1${CLEAR_COLOR}" "* $1"
}

# Ctrl+C handler: record the interruption in the journal, then exit with 130
leaf_on_sigint() {
  echo
  local _detail="command=leaf ${LEAF_COMMAND}, package=${PKG_PREFIX:-?}/${PKG_NAME:-?}, phase=${LEAF_PHASE:-none}"
  [ -z "${CURRENT_LOG}" ] || _detail+=", log=${CURRENT_LOG}"
  case "${LEAF_COMMAND}:${LEAF_PHASE}" in
    install:install|unpack:install)
      _detail+=" -- package may be PARTIALLY INSTALLED, reinstall or remove it manually"
      ;;
    remove:remove)
      _detail+=" -- package may be PARTIALLY REMOVED, remove it again"
      ;;
  esac
  [ -w "${LOG_DIR}/leaf.log" ] && leaf_journal WARNING "interrupted by user (SIGINT): ${_detail}"
  leaf_warning "Interrupted by user"
  [ -z "${CURRENT_LOG}" ] || leaf_warning "Partial log: ${CURRENT_LOG}"
  exit 130
}

# run one build/install phase: output goes to the log file (quiet mode)
# or to both the terminal and the log file (verbose mode)
leaf_run_phase() {
  local _label="$1" _category="$2"
  shift 2
  local _log
  case "${_category}" in
    build)       _log="${BUILD_LOG_FILE}" ;;
    transaction) _log="${TRANS_LOG_FILE}" ;;
  esac
  CURRENT_LOG="${_log}"
  LEAF_PHASE="${_label}"
  echo "==> [$(date '+%F %T')] ${_label}" >> "${_log}"
  local _start=${SECONDS} _rc
  if [[ "${VERBOSE}" == "true" ]]; then
    echo -e "${GREEN_COLOR}==> ${_label}${CLEAR_COLOR}"
    ( set -e; "$@" ) 2>&1 | tee -a "${_log}"
    _rc=${PIPESTATUS[0]}
  else
    printf "  -> %-10s ... " "${_label}"
    ( set -e; "$@" ) >> "${_log}" 2>&1
    _rc=$?
  fi
  local _elapsed=$((SECONDS - _start))
  if [ ${_rc} -eq 0 ]; then
    [[ "${VERBOSE}" == "true" ]] || echo "done (${_elapsed}s)"
  else
    if [[ "${VERBOSE}" == "true" ]]; then
      echo -e "${RED_COLOR}==> ${_label} FAILED (${_elapsed}s)${CLEAR_COLOR}"
    else
      echo "FAILED (${_elapsed}s)"
    fi
    echo -e "${RED_COLOR}----- last 50 lines of ${_log} -----${CLEAR_COLOR}"
    tail -n 50 "${_log}"
    echo -e "${RED_COLOR}----- full log: ${_log} -----${CLEAR_COLOR}"
    leaf_journal ERROR "${PKG_PREFIX}/${PKG_NAME}: phase ${_label} failed (log=${_log})"
  fi
  return ${_rc}
}

leaf_record_message() {
  {
    printf '\n'
    printf "${PURPLE_COLOR}* Message from %s/%s${CLEAR_COLOR}\n" "${PKG_PREFIX}" "${PKG_NAME}"
    local _item
    for _item in "$@"; do
      printf "${GREEN_COLOR}* %s${CLEAR_COLOR}\n" "${_item}"
    done
  } >> "${MESSAGE_FILE}"
  leaf_journal INFO "Message from ${PKG_PREFIX}/${PKG_NAME}: $*"
}

leaf_print_usage() {
  cat << EOF
Usage: leaf [--verbose] [option] [packages]

Options:    
  prepare         prepare packages but do not build
  build           build packages but do not install
  install         install packages
  remove          remove packages
  clean           clean all source folders
  clean --logs    clean all source folders and logs
  list            list installed packages
  search          search packages by keyword
  show            show package details
  pack            build packages and pack
  unpack          unpack binary packages
  -v, --verbose   print full build output to the terminal

                    This leaf does not have Super Cow Powers.
EOF
}

leaf_create_directories() {
  local _dir
  for _dir in "${DIST_DIR}" "${BUILD_DIR}" "${PKGBUILD_DIR}" "${TRACE_DIR}" \
              "${HOOK_DIR}" "${BINARY_DIR}" "${TEMP_DIR}" \
              "${LOG_DIR}" "${LOG_DIR}/build" "${LOG_DIR}/transaction"; do
    install -dm755 "${_dir}" || leaf_error "Failed to create directory ${_dir}"
  done
}

leaf_check_permission() {
  [ ${EUID} -eq 0 ] || leaf_error "Permission denied"
}

leaf_find_pkgbuild() {
  local _location="$(find "${PKGBUILD_DIR}" -type f -wholename "*$1*.PKGBUILD" -printf "%P\n")"
  if [ -z "${_location}" ]; then
    leaf_error "Package $1's PKGBUILD does NOT exist"
  elif [[ $(echo "${_location}" | wc -l) == 1 ]]; then
    PKG_PREFIX="$(echo "${_location}" | awk -F'/' '{print $1}')"
    PKG_NAME="$(echo "${_location%.PKGBUILD}" | awk -F'/' '{print $2}')"
  else
    leaf_error "Ambiguous packages, the prefix or version of package must be specified"
  fi
}

leaf_reset_state() {
  options=()
  src_preinstall() {
    :
  }
  src_postinstall() {
    :
  }
  src_preremove() {
    :
  }
  src_postremove() {
    :
  }
}

leaf_parse_options() {
  local _option_array=(${DEFAULT_BUILD_OPTIONS[@]} ${options[@]})
  for option in "${_option_array[@]}"; do
    local key="${option#!}"        # strip the leading "!" to get the option name
    if [[ "${option}" == !* ]]; then
      BUILD_OPTIONS["${key}"]="0"  # a "!" prefix disables the option
    else
      BUILD_OPTIONS["${key}"]="1"  # otherwise enable it
    fi
  done
}

leaf_prepare_package() {
  leaf_run_phase "prepare" build src_prepare
}

leaf_strip_files() {
  pushd "${pkgdir}" > /dev/null 2>&1
  local _file
  find . -type f | while read -r _file; do
    case $(file -bi "${_file}") in
      *application/x-sharedlib*)             # shared libraries(.so)
        strip --strip-unneeded "${_file}" || leaf_warning "Failed to strip ${_file}"
        ;;
      *application/x-pie-executable*)        # position-independent executables
        strip --strip-unneeded "${_file}" || leaf_warning "Failed to strip ${_file}"
        ;;
      *application/x-archive*)               # static libraries(.a)
        strip --strip-debug "${_file}" || leaf_warning "Failed to strip ${_file}"
        ;;
      *application/x-object*)                # object files(.o)
        case "${_file}" in
          *.ko)                              # kernel module
            strip --strip-unneeded "${_file}" || leaf_warning "Failed to strip ${_file}"
            ;;
          *)
            ;;
        esac
        ;;
      *application/x-executable*)            # executable binaries
        strip --strip-all "${_file}" || leaf_warning "Failed to strip ${_file}"
        ;;
      *)
        ;;
    esac
  done
  popd > /dev/null 2>&1
}

leaf_remove_libtool_files() {
  find "${pkgdir}" -name "*.la" -delete
}

leaf_compress_manpages() {
  pushd "${pkgdir}" > /dev/null 2>&1
  [ ! -d usr/share/man ] || {
    local _item
    find usr/share/man -type f,l | while read -r _item; do
      case $(file -bi "${_item}") in
        *text*)
          /usr/bin/gzip -c -9 "${_item}" > "${_item}".gz
          rm -fv "${_item}"
          ;;
        *symlink*)
          ln -srv "$(readlink -m "${_item}")".gz "$(realpath "${_item}".gz)"
          rm -fv "${_item}"
          ;;
        *)
          ;;
      esac
    done
  }
  popd > /dev/null 2>&1
}

leaf_build_package() {
  leaf_run_phase "prepare" build src_prepare
  [ $? -eq 0 ] || return 1
  leaf_run_phase "build" build leaf_build_steps
  return $?
}

leaf_build_steps() {
  src_build
  local _option
  for _option in "${!BUILD_OPTIONS[@]}"; do
    case "${_option}" in
      strip)
        [[ "${BUILD_OPTIONS[$_option]}" == "0" ]] || leaf_strip_files
        ;;
      libtool)
        [[ "${BUILD_OPTIONS[$_option]}" == "1" ]] || leaf_remove_libtool_files
        ;;
      zipman)
        [[ "${BUILD_OPTIONS[$_option]}" == "0" ]] || leaf_compress_manpages
        ;;
      *)
        leaf_warning "Unknown build option \`${_option}\`"
        ;;
    esac
  done
  if [[ x"${ENABLE_DEBUG_TREE}" == x"true" ]] && [[ -x "$(echo ${TREE_PROG} | awk '{print $1}')" ]]; then
    ${TREE_PROG} "${pkgdir}"
  fi
}

leaf_trace_package() {
  pushd "$1" > /dev/null 2>&1
  local _trace_dir="${TRACE_DIR}/${PKG_PREFIX}/${PKG_NAME}"
  install -dm755 "${_trace_dir}"
  find . -type d | sort > "${_trace_dir}"/DIRS
  sed -i "1d" "$_trace_dir"/DIRS
  find . -type f | sort > "${_trace_dir}"/FILES
  find . -type l | sort > "${_trace_dir}"/LINKS
  sed -i "s/.//" "${_trace_dir}"/{DIRS,FILES,LINKS}
  popd > /dev/null 2>&1
}

leaf_invoke_hooks() {
  local _hook _file _target _run
  local _trace_dir="${TRACE_DIR}/${PKG_PREFIX}/${PKG_NAME}"
  find "${HOOK_DIR}" -type f -name "*.HOOK" | while read -r _hook; do
    target=()
    operation() { :; }
    source "${_hook}"
    _run="false"
    while read -r _file; do
      for _target in "${target[@]}"; do
        if [[ "${_file}" == ${_target} ]]; then
          _run="true"
          break 2
        fi
      done
    done < "${_trace_dir}"/FILES
    if [[ "${_run}" == "true" ]]; then
      operation
    fi
  done
}

leaf_merge_package() {
  pushd $1 > /dev/null 2>&1
  local _trace_dir="${TRACE_DIR}/${PKG_PREFIX}/${PKG_NAME}"
  local _item _mode _owner _group
  cat "${_trace_dir}"/DIRS | while read -r _item; do
    _mode=$(stat -c %a ."${_item}")
    _owner=$(stat -c %u ."${_item}")
    _group=$(stat -c %g ."${_item}")
    install -dm ${_mode} -o ${_owner} -g ${_group} "${_item}"
  done
  cat "${_trace_dir}"/FILES | while read -r _item; do
    _mode=$(stat -c %a ."${_item}")
    _owner=$(stat -c %u ."${_item}")
    _group=$(stat -c %g ."${_item}")
    install -Dm ${_mode} -o ${_owner} -g ${_group} ."${_item}" "${_item}"
  done
  cat "${_trace_dir}"/LINKS | while read -r _item; do
    cp -dp ."${_item}" "${_item}"
  done
  leaf_invoke_hooks
  popd > /dev/null 2>&1
}

leaf_update_package_database() {
  local _item="$(echo "$2" | awk 'BEGIN{FS="/";OFS="\\/"}{print $1,$2}')"
  case $1 in
    add)
      sed -i "/${_item}/d" "${INSTALLED_PACKAGES}"
      echo "$2" >> ${INSTALLED_PACKAGES}
      ;;
    delete)
      sed -i "/${_item}/d" "${INSTALLED_PACKAGES}"
      ;;
  esac
}

leaf_update_environment() {
  ldconfig
  [ ! -r /etc/profile ] || source /etc/profile
}

leaf_install_package() {
  leaf_build_package
  [ $? -eq 0 ] || return 1
  leaf_run_phase "install" transaction leaf_install_steps
  [ $? -eq 0 ] || return 1
  leaf_update_environment
  leaf_info "Package ${PKG_PREFIX}/${PKG_NAME} has been installed"
}

leaf_install_steps() {
  leaf_trace_package "${pkgdir}"
  src_preinstall
  leaf_merge_package "${pkgdir}"
  src_postinstall
  leaf_update_package_database add "${PKG_PREFIX}/${PKG_NAME}"
}

leaf_remove_package() {
  [ -n "$(grep "${PKG_PREFIX}/${PKG_NAME}" ${INSTALLED_PACKAGES})" ] || {
    leaf_error "Package ${PKG_PREFIX}/${PKG_NAME} is NOT installed"
  }
  leaf_run_phase "remove" transaction leaf_remove_steps
  [ $? -eq 0 ] || return 1
  leaf_update_environment
  leaf_info "Package ${PKG_PREFIX}/${PKG_NAME} has been removed"
}

leaf_remove_steps() {
  src_preremove
  local _file _link _directory
  cat "${TRACE_DIR}/${PKG_PREFIX}/${PKG_NAME}/FILES" | while read -r _file; do
    rm -fv "${_file}"
  done
  cat "${TRACE_DIR}/${PKG_PREFIX}/${PKG_NAME}/LINKS" | while read -r _link; do
    [ ! -L "${_link}" ] || rm -fv "${_link}"
  done
  cat "${TRACE_DIR}/${PKG_PREFIX}/${PKG_NAME}/DIRS" | while read -r _directory; do
    rmdir --ignore-fail-on-non-empty "${_directory}"
  done
  rm -rf "${TRACE_DIR}/${PKG_PREFIX}/${PKG_NAME}"
  src_postremove
  leaf_update_package_database delete "${PKG_PREFIX}/${PKG_NAME}"
}

leaf_pack_package() {
  leaf_build_package
  [ $? -eq 0 ] || return 1
  leaf_run_phase "pack" build leaf_pack_steps
  [ $? -eq 0 ] || return 1
  leaf_info "Package ${PKG_PREFIX}/${PKG_NAME} has been packed to ${BINARY_DIR}"
}

leaf_pack_steps() {
  pushd "${srcdir}" > /dev/null 2>&1
  echo "${PKG_PREFIX}" > .PKG_PREFIX
  install -m644 "${PKGBUILD_DIR}/${PKG_PREFIX}/${PKG_NAME}".PKGBUILD .PKGBUILD
  install -dm755 "${BINARY_DIR}"
  local _target="${BINARY_DIR}/${pkgname}-${pkgver}${BINARY_EXT}"
  rm -fv "${_target}"
  tar -I "${COMPRESS_PROG}" -cf "${_target}" "$(basename ${pkgdir})" .PKG{_PREFIX,BUILD}
  popd > /dev/null 2>&1
}

leaf_search_package() {
  local _item _regex
  for _item in "$@"; do
    _regex+="${_item}\|"
  done
  _regex="${_regex:0:${#_regex}-2}"
  find "${PKGBUILD_DIR}" -type f -regex ".*\(${_regex}\).*\.PKGBUILD" -printf "%P\n" | while read -r _item; do
    echo "${_item%.PKGBUILD}"
  done
}

leaf_show_package() {
  source "${PKGBUILD_DIR}/${PKG_PREFIX}/${PKG_NAME}".PKGBUILD
  echo "Package: ${pkgname}"
  echo "Version: ${pkgver}"
  echo "Description: ${pkgdesc}"
  echo "Homepage: ${homepage}"
  echo -e "License: ${license[@]}\n"
}

leaf_unpack_package() {
  tar -xf "$1" -C "${srcdir}" || leaf_error "Failed to extract $1"
  source "${srcdir}"/.PKGBUILD || leaf_error "Failed to load .PKGBUILD from $1"
  PKG_PREFIX="$(cat "${srcdir}"/.PKG_PREFIX)"
  PKG_NAME="${pkgname}-${pkgver}"
  leaf_setup_logs
  install -Dm644 "${srcdir}"/.PKGBUILD "${PKGBUILD_DIR}/${PKG_PREFIX}/${PKG_NAME}".PKGBUILD || return 1
  leaf_run_phase "install" transaction leaf_unpack_steps
  [ $? -eq 0 ] || return 1
  leaf_update_environment
  leaf_info "Package ${PKG_PREFIX}/${PKG_NAME} has been installed"
}

leaf_unpack_steps() {
  leaf_trace_package "${pkgdir}"
  src_preinstall
  leaf_merge_package "${pkgdir}"
  src_postinstall
  leaf_update_package_database add "${PKG_PREFIX}/${PKG_NAME}"
}

main "$@"
